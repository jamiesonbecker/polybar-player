#!/usr/bin/env bash
# polybar-player — MPRIS2 media control for polybar
set -euo pipefail

VERSION="0.1.0"

# Detect D-Bus CLI tool: busctl (real) > ebusctl (shim)
DBUS_CLI=""
if command -v busctl &>/dev/null; then
    DBUS_CLI="busctl"
elif command -v ebusctl &>/dev/null; then
    DBUS_CLI="ebusctl"
else
    echo "polybar-player: requires busctl or ebusctl in PATH" >&2
    exit 1
fi

# Defaults
FORMAT='{prev} {icon} {artist}: {title} {play_pause} {next}'
MAX_LENGTH=30
SCROLL_SPEED=1
SCROLL_SEP=" ... "
SCROLL_ENABLED=1
QUIET=0
FORCE_PLAYER=""
ICON_PREV=$'\uf04a'
ICON_PLAY=$'\uf04b'
ICON_PAUSE=$'\uf04c'
ICON_NEXT=$'\uf04e'

# Known player icons (Nerd Font)
declare -A PLAYER_ICONS=(
    [spotify]=$'\uf1bc'
    [firefox]=$'\uf269'
    [chromium]=$'\uf268'
    [chrome]=$'\uf268'
    [vlc]=$'\ufa7b'
    [mpd]=$'\ufc58'
)
ICON_DEFAULT=$'\ufc58'

# State directory
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp/polybar-player-$(id -u)}/polybar-player"

# Self path for polybar click actions
SELF="$(readlink -f "$0")"

usage() {
    cat <<'EOF'
Usage: polybar-player [OPTIONS]

Display options:
  -f, --format FORMAT        Output format (default: {prev} {icon} {artist}: {title} {play_pause} {next})
  -l, --max-length N         Max display length for scrolling text (default: 30)
  -s, --scroll-speed N       Characters per tick (default: 1)
  --scroll-separator STR     Wrap separator (default: " ... ")
  --no-scroll                Disable scrolling, truncate instead
  -q, --quiet                No output when paused
  --icons PREV PLAY PAUSE NEXT  Override icons
  --player NAME              Force specific player

Actions:
  --play-pause               Toggle play/pause
  --next                     Next track
  --prev                     Previous track
  --select                   Open player selector
  -h, --help                 Show this help
  --version                  Show version
EOF
}

parse_args() {
    local action=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--format)       FORMAT="$2"; shift 2 ;;
            -l|--max-length)   MAX_LENGTH="$2"; shift 2 ;;
            -s|--scroll-speed) SCROLL_SPEED="$2"; shift 2 ;;
            --scroll-separator) SCROLL_SEP="$2"; shift 2 ;;
            --no-scroll)       SCROLL_ENABLED=0; shift ;;
            -q|--quiet)        QUIET=1; shift ;;
            --player)          FORCE_PLAYER="$2"; shift 2 ;;
            --icons)           ICON_PREV="$2"; ICON_PLAY="$3"; ICON_PAUSE="$4"; ICON_NEXT="$5"; shift 5 ;;
            --play-pause)      action="play_pause"; shift ;;
            --next)            action="next"; shift ;;
            --prev)            action="prev"; shift ;;
            --select)          action="select"; shift ;;
            -h|--help)         usage; exit 0 ;;
            --version)         echo "polybar-player $VERSION"; exit 0 ;;
            _discover)         discover_players; exit 0 ;;
            _active_player)    active_player; exit 0 ;;
            _set_active)       set_active "$2"; exit 0 ;;
            _scroll_text)      scroll_text "$2" "$3" "$4" "$5"; exit 0 ;;
            _format_output)    format_output "$2"; exit 0 ;;
            *)                 echo "polybar-player: unknown option: $1" >&2; exit 1 ;;
        esac
    done

    case "$action" in
        play_pause|next|prev) player_action "$action"; exit 0 ;;
        select)               select_player; exit 0 ;;
        "")                   display_output ;;
    esac
}

# discover_players — list MPRIS2 player service names, one per line
discover_players() {
    "$DBUS_CLI" list --acquired 2>/dev/null \
        | grep '^org\.mpris\.MediaPlayer2\.' \
        || true
}

# active_player — return the service name of the active player
active_player() {
    mkdir -p "$STATE_DIR"
    local players
    players=$(discover_players)
    [[ -z "$players" ]] && return 1

    # If user forced a player, use it
    if [[ -n "$FORCE_PLAYER" ]]; then
        if printf '%s\n' "$players" | grep -qxF "$FORCE_PLAYER"; then
            printf '%s\n' "$FORCE_PLAYER"
            return 0
        fi
        echo "polybar-player: forced player $FORCE_PLAYER not found" >&2
        return 1
    fi

    # Check persisted selection
    local state_file="$STATE_DIR/active"
    if [[ -f "$state_file" ]]; then
        local saved
        saved=$(cat "$state_file")
        if printf '%s\n' "$players" | grep -qxF "$saved"; then
            printf '%s\n' "$saved"
            return 0
        fi
    fi

    # Prefer the player that's currently Playing
    local p
    while IFS= read -r p; do
        local status
        status=$("$DBUS_CLI" get-property "$p" /org/mpris/MediaPlayer2 \
            org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null) || continue
        if [[ "$status" == *'"Playing"'* ]]; then
            printf '%s\n' "$p"
            return 0
        fi
    done <<< "$players"

    # Fall back to first
    printf '%s\n' "$players" | head -1
}

# set_active PLAYER_SERVICE — persist player selection
set_active() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_DIR/active"
}

# scroll_text TEXT MAX_LENGTH SPEED SEPARATOR
# Returns a sliding window of TEXT. Maintains offset in state file.
# If TEXT fits in MAX_LENGTH, returns it unchanged.
scroll_text() {
    local text="$1" max_len="$2" speed="$3" sep="$4"

    # If it fits, no scrolling needed
    if [[ ${#text} -le $max_len ]]; then
        printf '%s' "$text"
        return 0
    fi

    mkdir -p "$STATE_DIR"
    local offset_file="$STATE_DIR/scroll-offset"

    # Read current offset
    local offset=0
    if [[ -f "$offset_file" ]]; then
        offset=$(cat "$offset_file")
        # Validate it's a number
        [[ "$offset" =~ ^[0-9]+$ ]] || offset=0
    fi

    # Build the scrolling buffer: text + separator + text (for seamless wrap)
    local buffer="${text}${sep}${text}${sep}"
    local buf_cycle_len=$(( ${#text} + ${#sep} ))

    # Normalize offset within cycle
    offset=$(( offset % buf_cycle_len ))

    # Extract window
    local window="${buffer:$offset:$max_len}"
    printf '%s' "$window"

    # Advance offset for next call
    local next_offset=$(( offset + speed ))
    printf '%d' "$next_offset" > "$offset_file"
}

# get_player_icon SERVICE_NAME
get_player_icon() {
    local service="$1"
    local name="${service##*.}"
    name="${name%%.*}"
    name="${name,,}"
    printf '%s' "${PLAYER_ICONS[$name]:-$ICON_DEFAULT}"
}

# get_metadata SERVICE — sets METADATA_TITLE, METADATA_ARTIST, METADATA_ALBUM
get_metadata() {
    local service="$1"
    local raw
    raw=$("$DBUS_CLI" get-property "$service" /org/mpris/MediaPlayer2 \
        org.mpris.MediaPlayer2.Player Metadata 2>/dev/null) || return 1

    METADATA_TITLE=""
    METADATA_ARTIST=""
    METADATA_ALBUM=""

    while IFS= read -r line; do
        case "$line" in
            *'"xesam:title"'*)
                METADATA_TITLE=$(printf '%s' "$line" | sed 's/.*s "\(.*\)"/\1/')
                ;;
            *'"xesam:artist"'*)
                METADATA_ARTIST=$(printf '%s' "$line" | sed 's/.*"\([^"]*\)"$/\1/')
                ;;
            *'"xesam:album"'*)
                METADATA_ALBUM=$(printf '%s' "$line" | sed 's/.*s "\(.*\)"/\1/')
                ;;
        esac
    done <<< "$raw"
}

# get_playback_status SERVICE
get_playback_status() {
    local raw
    raw=$("$DBUS_CLI" get-property "$1" /org/mpris/MediaPlayer2 \
        org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null) || {
        printf 'Stopped'
        return
    }
    printf '%s' "$raw" | sed 's/^s "\(.*\)"/\1/'
}

# get_bool_property SERVICE PROPERTY
get_bool_property() {
    local raw
    raw=$("$DBUS_CLI" get-property "$1" /org/mpris/MediaPlayer2 \
        org.mpris.MediaPlayer2.Player "$2" 2>/dev/null) || {
        printf 'false'
        return
    }
    printf '%s' "$raw" | sed 's/^b //'
}

# polybar_action COMMAND CONTENT
polybar_action() {
    local cmd="$1" content="$2"
    printf '%%{A1:%s %s:}%s%%{A}' "$SELF" "$cmd" "$content"
}

# format_output SERVICE
format_output() {
    local service="$1"

    local status
    status=$(get_playback_status "$service")

    if [[ "$QUIET" -eq 1 && "$status" != "Playing" ]]; then
        return 0
    fi

    get_metadata "$service"

    local can_next can_prev
    can_next=$(get_bool_property "$service" CanGoNext)
    can_prev=$(get_bool_property "$service" CanGoPrevious)

    local display_artist="$METADATA_ARTIST"
    local display_title="$METADATA_TITLE"
    if [[ "$SCROLL_ENABLED" -eq 1 ]]; then
        display_title=$(scroll_text "$METADATA_TITLE" "$MAX_LENGTH" "$SCROLL_SPEED" "$SCROLL_SEP")
        display_artist=$(scroll_text "$METADATA_ARTIST" "$MAX_LENGTH" "$SCROLL_SPEED" "$SCROLL_SEP")
    else
        if [[ ${#display_title} -gt $MAX_LENGTH ]]; then
            display_title="${display_title:0:$MAX_LENGTH}..."
        fi
        if [[ ${#display_artist} -gt $MAX_LENGTH ]]; then
            display_artist="${display_artist:0:$MAX_LENGTH}..."
        fi
    fi

    local icon
    icon=$(get_player_icon "$service")

    local pp_icon
    if [[ "$status" == "Playing" ]]; then
        pp_icon="$ICON_PAUSE"
    else
        pp_icon="$ICON_PLAY"
    fi

    local output="$FORMAT"
    output="${output//\{artist\}/$display_artist}"
    output="${output//\{title\}/$display_title}"
    output="${output//\{album\}/$METADATA_ALBUM}"
    output="${output//\{status\}/$status}"
    output="${output//\{icon\}/$(polybar_action --select "$icon")}"
    output="${output//\{play_pause\}/$(polybar_action --play-pause "$pp_icon")}"

    if [[ "$can_prev" == "true" ]]; then
        output="${output//\{prev\}/$(polybar_action --prev "$ICON_PREV")}"
    else
        output="${output//\{prev\}/}"
    fi
    if [[ "$can_next" == "true" ]]; then
        output="${output//\{next\}/$(polybar_action --next "$ICON_NEXT")}"
    else
        output="${output//\{next\}/}"
    fi

    printf '%s\n' "$output"
}

# player_action ACTION — send a command to the active player
player_action() {
    local action="$1"
    local service
    service=$(active_player) || exit 0

    local method
    case "$action" in
        play_pause) method="PlayPause" ;;
        next)       method="Next" ;;
        prev)       method="Previous" ;;
        *)          echo "polybar-player: unknown action: $action" >&2; exit 1 ;;
    esac

    "$DBUS_CLI" call "$service" /org/mpris/MediaPlayer2 \
        org.mpris.MediaPlayer2.Player "$method" 2>/dev/null || true
}

# select_player — present a menu to choose the active player
select_player() {
    local players
    players=$(discover_players)
    [[ -z "$players" ]] && exit 0

    local count
    count=$(printf '%s\n' "$players" | wc -l)

    # If only one player, just select it
    if [[ "$count" -eq 1 ]]; then
        set_active "$players"
        return 0
    fi

    # Build display names: org.mpris.MediaPlayer2.spotify -> spotify
    local display_names=""
    local -a services=()
    while IFS= read -r svc; do
        services+=("$svc")
        local name="${svc##*MediaPlayer2.}"
        display_names+="$name"$'\n'
    done <<< "$players"

    local selected=""
    if command -v rofi &>/dev/null; then
        selected=$(printf '%s' "$display_names" | rofi -dmenu -p "Player" -i 2>/dev/null) || return 0
    elif command -v dmenu &>/dev/null; then
        selected=$(printf '%s' "$display_names" | dmenu -p "Player:" 2>/dev/null) || return 0
    else
        # Click-cycle: advance to next player
        local current
        current=$(active_player) || return 0
        local found=0
        local first=""
        while IFS= read -r svc; do
            [[ -z "$first" ]] && first="$svc"
            if [[ "$found" -eq 1 ]]; then
                set_active "$svc"
                return 0
            fi
            [[ "$svc" == "$current" ]] && found=1
        done <<< "$players"
        # Wrap around to first
        set_active "$first"
        return 0
    fi

    # Match display name back to service
    while IFS= read -r svc; do
        local name="${svc##*MediaPlayer2.}"
        if [[ "$name" == "$selected" ]]; then
            set_active "$svc"
            return 0
        fi
    done <<< "$players"
}

display_output() {
    local service
    service=$(active_player) || {
        echo ""
        exit 0
    }
    format_output "$service"
}

parse_args "$@"
